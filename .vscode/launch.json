{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Deno Run",
      "request": "launch",
      "type": "node",
      "cwd": "${workspaceFolder}",
      "runtimeExecutable": "deno",
      "runtimeArgs": [
        "run",
        "--inspect-brk",
        "--allow-all",
        "--unstable-otel",
        "${file}"
      ],
      "attachSimplePort": 9229
    },
    {
      "name": "Deno Test",
      "request": "launch",
      "type": "node",
      "cwd": "${workspaceFolder}",
      "runtimeExecutable": "deno",
      "runtimeArgs": [
        "test",
        "--inspect-brk",
        "--allow-all",
        "--unstable-otel",
        "${file}"
      ],
      "attachSimplePort": 9229
    }
  ]
}
